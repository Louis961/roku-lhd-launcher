# Copy to .env and fill in. Never commit .env.
# Roku TV / player IP — reserve a static DHCP lease for it.
TV_IP=192.168.1.50
PORT=8099

# Relaunch LHD Launcher when Home is pressed from another app.
AUTO_LAUNCH=1
LAUNCHER_APP_ID=dev

# Immich (optional). API key needs asset.read and asset.view.
# Immich -> Account Settings -> API Keys -> New API Key.
IMMICH_URL=http://192.168.1.50:2283
IMMICH_API_KEY=
# Optional: limit the screensaver photos to album UUIDs (comma-separated).
IMMICH_ALBUM_IDS=
