' Point this at the Lua helper that runs on your LAN (see helper/.env).
' Example: http://192.168.1.50:8099
function lhdHelper() as String
    return "http://192.168.1.103:8099"
end function

' ---- Daybreak (merged): generated by daybreak/build_channel.py ----

' Generated by daybreak/build_channel.py from config/family.json and .env.
' Not committed: contains the family calendar's private iCal URL.
function DaybreakConfig() as object
    place = ParseJson("{""town"": ""Long Beach"", ""region"": ""CA"", ""area"": ""Los Angeles County"", ""seasonRegion"": ""Southern California"", ""timezone"": ""America/Los_Angeles"", ""lake"": ""none"", ""college"": ""none"", ""curbside"": ""none"", ""teams"": [], ""rivalry"": []}")
    place.news = { queries: ["Long Beach CA", "Long Beach weather"] }
    return {
        household: "Home",
        city: "Long Beach, CA",
        lat: 33.8045, lon: -118.1876,
        curbWeekday: 1,
        place: place,
        chores: ParseJson("[]"),
        gentleNews: true,
        apps: ["Netflix", "YouTube", "Plex", "Prime Video", "Hulu", "Disney+"],
        calendarUrl: "",
        members: []
    }
end function
